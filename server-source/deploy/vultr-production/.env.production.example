AKFES_DOMAIN=api.akfes.pe.kr
DEBUG=false
JWT_ALGORITHM=RS256
JWT_ISSUER=akfes-auth
JWT_AUDIENCE=akfes-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
DB_TLS_ENABLED=true
REDIS_TLS_ENABLED=true
REDIS_REALTIME_ENABLED=true
REDIS_REQUIRED_FOR_READY=true
WS_SESSION_REVALIDATE_SECONDS=30
WS_MAX_FRAME_BYTES=16384
WS_ALLOWED_ORIGINS='["https://api.akfes.pe.kr","tauri://localhost","http://tauri.localhost"]'
CORS_ORIGINS='["tauri://localhost","http://tauri.localhost"]'
TRUSTED_HOSTS='["api.akfes.pe.kr","localhost","127.0.0.1"]'
ADMIN_USERNAMES='["admin"]'
ADMIN_WEBAUTHN_RP_ID=api.akfes.pe.kr
ADMIN_WEBAUTHN_ORIGIN=https://api.akfes.pe.kr
# Optional contact-verification providers. Leave blank until configured.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_FROM=
EMAIL_SMTP_STARTTLS=true
SMS_WEBHOOK_URL=
RATE_LIMIT_FAIL_CLOSED=true
REQUIRE_FIRST_DEVICE_ARDUINO=false
REQUIRE_DEVICE_POP=true
ARDUINO_ACTIONS='["device.bootstrap","device.approve","device.revoke","device.revoke_all","arduino.pin_setup","secret.gate_register"]'
FILES_DIR=/app/encrypted-files
AKFES_DATA_DIR=/opt/akfes/data
AKFES_SECRETS_DIR=/opt/akfes/secrets/generated
